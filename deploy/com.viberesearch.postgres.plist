<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.viberesearch.postgres</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Postgres.app/Contents/Versions/latest/bin/postgres</string>
    <string>-D</string>
    <string>__PROJECT_DIR__/.local/postgres</string>
    <string>-h</string>
    <string>127.0.0.1</string>
    <string>-p</string>
    <string>54329</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/vibe-postgres.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/vibe-postgres.err.log</string>
</dict>
</plist>
