<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>VR_DATABASE_URL</key>
		<string>__VR_DATABASE_URL__</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.viberesearch.backend</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PROJECT_DIR__/backend/.venv/bin/python</string>
		<string>-m</string>
		<string>uvicorn</string>
		<string>app:app</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8900</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/vibe-backend.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/vibe-backend.log</string>
	<key>WorkingDirectory</key>
	<string>__PROJECT_DIR__/backend</string>
</dict>
</plist>
